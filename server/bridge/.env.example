# Copy to .env and fill in. Never commit .env.
BROKER_URL=mqtts://jf1aa2a3.ala.asia-southeast1.emqxsl.com:8883
BRIDGE_USER=bridge
BRIDGE_PASS=<ask the firmware side for the bridge password>

# Agents API (your service). Leave AGENTS_API empty to run in log-only mode.
AGENTS_API=http://localhost:4000
MONAID_TOKEN=<shared X-Monaid-Token value>

# Set to 1 when your GET /feed SSE exists; until then the bridge only forwards events.
FEED_ENABLED=0
