# Private keys are written here by `npm run wallet:new` — never paste or commit them by hand.
# Deployer / MonaidCore owner
DEPLOYER_PRIVATE_KEY=
# Robot 1's agent wallet (server-side)
AGENT_1_PRIVATE_KEY=
# Optional: override the public RPC (default https://testnet-rpc.monad.xyz, 50 rps)
MONAD_TESTNET_RPC_URL=
# Optional: Etherscan v2 API key, for verifying on Monadscan
ETHERSCAN_API_KEY=
